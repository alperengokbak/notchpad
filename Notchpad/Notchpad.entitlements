<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime is on. These are the only protected things Notchpad uses. -->
	<!-- Mirror widget (only after a click on it). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Next event, Reminders: read and change events and reminders (EventKit). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Music widget: AppleScript to Apple Music and Spotify. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
